<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="footnote-reference">
    <title>Footnotes</title>
    <shortdesc>This reference lists the properties, the rule, the counter and the pseudo-elements that CSSMedia uses for footnotes.</shortdesc>
    <refbody>
        <section id="footnote-properties">
            <title>Properties, rule and counter</title>
            <table id="footnote-properties__table">
                <tgroup cols="5">
                    <thead conkeyref="ref-headers/head-properties"><row><entry/><entry/><entry/><entry/><entry/></row></thead>
                    <tbody>
                        <row conkeyref="ref-floats/row-float"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-content/row-footnote-display"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-content/row-footnote-policy"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-content/row-footnote-counter"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-footnote"><entry/><entry/><entry/><entry/><entry/></row>
                    </tbody>
                </tgroup>
            </table>
        </section>
        <section id="footnote-pseudo-elements">
            <title>Pseudo-elements</title>
            <table id="footnote-pseudo-elements__table">
                <tgroup cols="5">
                    <thead conkeyref="ref-headers/head-selectors"><row><entry/><entry/><entry/><entry/><entry/></row></thead>
                    <tbody>
                        <row conkeyref="ref-selectors/row-footnote-call"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-selectors/row-footnote-marker"><entry/><entry/><entry/><entry/><entry/></row>
                    </tbody>
                </tgroup>
            </table>
        </section>
    </refbody>
</reference>
