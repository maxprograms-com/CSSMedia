                        <row id="row-top-right-corner" valign="middle">
                            <entry>
                                <codeph>@top-right-corner</codeph>
                            </entry>
                            <entry>Defines the fixed-size box at the intersection of the top and right page margins.</entry>
                            <entry />
                            <entry />
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#at-ruledef-top-right-corner" scope="external" format="html">CSS Paged Media 3, <codeph>@top-right-corner</codeph>
                                </xref>
