                        </row>
                        <row id="row-top-center" valign="middle">
                            <entry>
                                <codeph>@top-center</codeph>
                            </entry>
                            <entry>Defines the centered box in the top page margin.</entry>
                            <entry />
                            <entry />
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#at-ruledef-top-center" scope="external" format="html">CSS Paged Media 3, <codeph>@top-center</codeph>
