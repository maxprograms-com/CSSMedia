                        <row id="row-footnote" valign="middle">
                            <entry>
                                <codeph>@footnote</codeph>
                            </entry>
                            <entry>Styles the footnote area at the bottom of the page. It goes inside an <codeph>@page</codeph> rule.</entry>
                            <entry>A block of declarations, such as borders, margins, padding and <codeph>max-height</codeph>.</entry>
                            <entry />
                            <entry>
                                <xref href="https://www.w3.org/TR/css-gcpm-3/#footnote-area" scope="external" format="html">CSS GCPM 3 §2.4</xref>
                            </entry>
