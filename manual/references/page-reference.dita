                        <row id="row-right-top" valign="middle">
                            <entry>
                                <codeph>@right-top</codeph>
                            </entry>
                            <entry>Defines the box between the top-right corner and right-middle boxes.</entry>
                            <entry />
                            <entry />
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#at-ruledef-right-top" scope="external" format="html">CSS Paged Media 3, <codeph>@right-top</codeph>
                                </xref>
                            </entry>
                        </row>
                        <row id="row-right-middle" valign="middle">
                            <entry>
                                <codeph>@right-middle</codeph>
                            </entry>
                            <entry>Defines the centered box in the right page margin.</entry>
                            <entry />
                            <entry />
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#at-ruledef-right-middle" scope="external" format="html">CSS Paged Media 3, <codeph>@right-middle</codeph>
                                </xref>
                            </entry>
                        </row>
                        <row id="row-right-bottom" valign="middle">
                            <entry>
                                <codeph>@right-bottom</codeph>
                            </entry>
                            <entry>Defines the box between the right-middle and bottom-right corner boxes.</entry>
                            <entry />
                            <entry />
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#at-ruledef-right-bottom" scope="external" format="html">CSS Paged Media 3, <codeph>@right-bottom</codeph>
                                </xref>
