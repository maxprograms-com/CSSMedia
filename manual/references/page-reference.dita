<reference id="page-reference">
    <title>Page reference</title>
    <refbody>
        <section>
            <table id="page-reference__I_2s_">
                <tgroup cols="5">
                    <thead>
                        <row valign="middle">
                            <entry align="center">Name</entry>
                            <entry align="center">Description</entry>
                            <entry align="center">Values</entry>
                            <entry align="center">Default</entry>
                            <entry align="center">Specification</entry>
                        </row>
                    </thead>
                    <tbody>
                        <row id="row-page" valign="middle">
                            <entry>
                                <codeph>page</codeph>
                            </entry>
                            <entry>Assigns a named page type to a box.</entry>
                            <entry>
                                <codeph>auto</codeph> or a custom identifier</entry>
                            <entry>
                                <codeph>auto</codeph>
                            </entry>
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#propdef-page" scope="external" format="html">CSS Paged Media 3, <codeph>page</codeph>
                                </xref>
                            </entry>
                        </row>
                        <row id="row-at-page" valign="middle">
                            <entry>
                                <codeph>@page</codeph>
                            </entry>
                            <entry>Defines page-box declarations and may contain page-margin rules.</entry>
                            <entry>Optional comma-separated page selectors</entry>
                            <entry />
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#at-ruledef-page" scope="external" format="html">CSS Paged Media 3, <codeph>@page</codeph>
                                </xref>
                            </entry>
                        </row>
                        <row id="row-size" valign="middle">
                            <entry>
                                <codeph>size</codeph>
                            </entry>
                            <entry>Sets page-box size and orientation. <codeph>auto</codeph> uses A4.</entry>
                            <entry>
                                <codeph>auto</codeph>; one or two lengths; or <codeph>A3</codeph>, <codeph>A4</codeph>, <codeph>A5</codeph>, <codeph>B4</codeph>, <codeph>B5</codeph>, <codeph>JIS-B4</codeph>, <codeph>JIS-B5</codeph>, <codeph>ledger</codeph>, <codeph>legal</codeph>, or <codeph>letter</codeph>, optionally combined with <codeph>portrait</codeph> or <codeph>landscape</codeph>
                            </entry>
                            <entry>A4</entry>
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#descdef-page-size" scope="external" format="html">CSS Paged Media 3, <codeph>size</codeph>
                                </xref>
                            </entry>
                        </row>
                        <row valign="middle">
                            <entry>
                                <codeph>bleed</codeph>
                            </entry>
                            <entry>Sets the bleed extension beyond the page box. <codeph>auto</codeph> uses <codeph>6pt</codeph> with crop marks and <codeph>0</codeph> otherwise.</entry>
                            <entry>
                                <codeph>auto</codeph> or a length</entry>
                            <entry>
                                <codeph>0</codeph> (<codeph>auto</codeph>)</entry>
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#descdef-page-bleed" scope="external" format="html">CSS Paged Media 3, <codeph>bleed</codeph>
                                </xref>
                            </entry>
                        </row>
                        <row valign="middle">
                            <entry>
                                <codeph>marks</codeph>
                            </entry>
                            <entry>Requests crop marks, registration marks, or both outside the page box.</entry>
                            <entry>
                                <codeph>none</codeph>, <codeph>crop</codeph>, <codeph>cross</codeph>, or both <codeph>crop</codeph> and <codeph>cross</codeph>
                            </entry>
                            <entry>
                                <codeph>none</codeph>
                            </entry>
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#descdef-page-marks" scope="external" format="html">CSS Paged Media 3, <codeph>marks</codeph>
                                </xref>
                            </entry>
                        </row>
                        <row valign="middle">
                            <entry>
                                <codeph>page-orientation</codeph>
                            </entry>
                            <entry>Rotates the laid-out page in the output.</entry>
                            <entry>
                                <codeph>upright</codeph>, <codeph>rotate-left</codeph>, or <codeph>rotate-right</codeph>
                            </entry>
                            <entry>
                                <codeph>upright</codeph>
                            </entry>
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#descdef-page-page-orientation" scope="external" format="html">CSS Paged Media 3, <codeph>page-orientation</codeph>
                                </xref>
                            </entry>
                        </row>
                        <row id="row-top-left-corner" valign="middle">
                            <entry>
                                <codeph>@top-left-corner</codeph>
                            </entry>
                            <entry>Defines the fixed-size box at the intersection of the top and left page margins.</entry>
                            <entry />
                            <entry />
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#at-ruledef-top-left-corner" scope="external" format="html">CSS Paged Media 3, <codeph>@top-left-corner</codeph>
                                </xref>
                            </entry>
                        </row>
                        <row id="row-top-left" valign="middle">
                            <entry>
                                <codeph>@top-left</codeph>
                            </entry>
                            <entry>Defines the box between the top-left corner and top-center boxes.</entry>
                            <entry />
                            <entry />
                            <entry>
                                <xref href="https://www.w3.org/TR/css-page-3/#at-ruledef-top-left" scope="external" format="html">CSS Paged Media 3, <codeph>@top-left</codeph>
                                </xref>
