<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="page-setup-chapter-reference">
    <title>Page setup reference</title>
    <shortdesc>This reference lists the rules, descriptors and properties that CSSMedia uses to define pages.</shortdesc>
    <refbody>
        <section id="page-setup-pages">
            <title>Page rule, size and page type</title>
            <table id="page-setup-pages__table">
                <tgroup cols="5">
                    <thead conkeyref="ref-headers/head-properties"><row><entry/><entry/><entry/><entry/><entry/></row></thead>
                    <tbody>
                        <row conkeyref="ref-page/row-at-page"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-size"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-page"><entry/><entry/><entry/><entry/><entry/></row>
                    </tbody>
                </tgroup>
            </table>
        </section>
        <section id="page-setup-margins">
            <title>Page margins</title>
            <table id="page-setup-margins__table">
                <tgroup cols="5">
                    <thead conkeyref="ref-headers/head-properties"><row><entry/><entry/><entry/><entry/><entry/></row></thead>
                    <tbody>
                        <row conkeyref="ref-box-model/row-margin"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-box-model/row-margin-top"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-box-model/row-margin-right"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-box-model/row-margin-bottom"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-box-model/row-margin-left"><entry/><entry/><entry/><entry/><entry/></row>
                    </tbody>
                </tgroup>
            </table>
        </section>
        <section id="page-setup-margin-rules">
            <title>Page-margin rules</title>
            <table id="page-setup-margin-rules__table">
                <tgroup cols="5">
                    <thead conkeyref="ref-headers/head-properties"><row><entry/><entry/><entry/><entry/><entry/></row></thead>
                    <tbody>
                        <row conkeyref="ref-page/row-top-left-corner"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-top-left"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-top-center"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-top-right"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-top-right-corner"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-right-top"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-right-middle"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-right-bottom"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-bottom-right-corner"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-bottom-right"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-bottom-center"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-bottom-left"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-bottom-left-corner"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-left-bottom"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-left-middle"><entry/><entry/><entry/><entry/><entry/></row>
                        <row conkeyref="ref-page/row-left-top"><entry/><entry/><entry/><entry/><entry/></row>
                    </tbody>
                </tgroup>
            </table>
        </section>
        <section conkeyref="ref-page/page-breaks"/>
    </refbody>
</reference>
