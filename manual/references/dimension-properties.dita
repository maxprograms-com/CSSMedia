<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="dimension-properties">
    <title>Box sizes</title>
    <shortdesc>This reference lists the properties that CSSMedia uses to size a box.</shortdesc>
    <refbody>
        <section id="preferred-sizes">
            <title>Preferred sizes</title>
            <table id="preferred-sizes__table">
                <tgroup cols="5">
                    <thead conkeyref="ref-headers/head-properties"/>
                    <tbody>
                        <row>
                            <entry><codeph>box-sizing</codeph></entry>
                            <entry>Chooses what <codeph>width</codeph> and <codeph>height</codeph> measure. <codeph>content-box</codeph> measures the content, and the padding and the border are added. <codeph>border-box</codeph> measures the box through the border.</entry>
                            <entry><codeph>content-box</codeph> or <codeph>border-box</codeph></entry>
                            <entry><codeph>content-box</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-3/#propdef-box-sizing" scope="external" format="html">CSS Sizing 3 §3.3</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>width</codeph></entry>
                            <entry>Sets the preferred width of the box.</entry>
                            <entry><codeph>auto</codeph>, a non-negative length or percentage, <codeph>stretch</codeph>, <codeph>contain</codeph>, <codeph>min-content</codeph>, <codeph>max-content</codeph>, <codeph>fit-content</codeph>, <codeph>fit-content()</codeph>, <codeph>calc-size()</codeph> or <codeph>anchor-size()</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-3/#propdef-width" scope="external" format="html">CSS Sizing 3 §3.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>height</codeph></entry>
                            <entry>Sets the preferred height of the box.</entry>
                            <entry>The values of <codeph>width</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-3/#propdef-height" scope="external" format="html">CSS Sizing 3 §3.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>inline-size</codeph></entry>
                            <entry>Sets the preferred size along the inline axis, which is the width in horizontal text.</entry>
                            <entry>The values of <codeph>width</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-logical-1/#propdef-inline-size" scope="external" format="html">CSS Logical Properties 1 §4.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>block-size</codeph></entry>
                            <entry>Sets the preferred size along the block axis, which is the height in horizontal text.</entry>
                            <entry>The values of <codeph>width</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-logical-1/#propdef-block-size" scope="external" format="html">CSS Logical Properties 1 §4.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>size</codeph></entry>
                            <entry>Sets <codeph>width</codeph> and <codeph>height</codeph>. One value applies to both.</entry>
                            <entry>One or two values of <codeph>width</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-4/#propdef-size" scope="external" format="html">CSS Sizing 4 §3.1</xref></entry>
                        </row>
                    </tbody>
                </tgroup>
            </table>
        </section>
        <section id="minimum-and-maximum-sizes">
            <title>Minimum and maximum sizes</title>
            <table id="minimum-and-maximum-sizes__table">
                <tgroup cols="5">
                    <thead conkeyref="ref-headers/head-properties"/>
                    <tbody>
                        <row>
                            <entry><codeph>min-width</codeph></entry>
                            <entry>Sets the smallest width of the box.</entry>
                            <entry>The values of <codeph>width</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-3/#propdef-min-width" scope="external" format="html">CSS Sizing 3 §3.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>min-height</codeph></entry>
                            <entry>Sets the smallest height of the box.</entry>
                            <entry>The values of <codeph>width</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-3/#propdef-min-height" scope="external" format="html">CSS Sizing 3 §3.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>min-inline-size</codeph></entry>
                            <entry>Sets the smallest size along the inline axis.</entry>
                            <entry>The values of <codeph>width</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-logical-1/#propdef-min-inline-size" scope="external" format="html">CSS Logical Properties 1 §4.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>min-block-size</codeph></entry>
                            <entry>Sets the smallest size along the block axis.</entry>
                            <entry>The values of <codeph>width</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-logical-1/#propdef-min-block-size" scope="external" format="html">CSS Logical Properties 1 §4.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>min-size</codeph></entry>
                            <entry>Sets <codeph>min-width</codeph> and <codeph>min-height</codeph>. One value applies to both.</entry>
                            <entry>One or two values of <codeph>min-width</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-4/#propdef-min-size" scope="external" format="html">CSS Sizing 4 §3.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>max-width</codeph></entry>
                            <entry>Sets the largest width of the box.</entry>
                            <entry><codeph>none</codeph>, or the values of <codeph>width</codeph> except <codeph>auto</codeph></entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-3/#propdef-max-width" scope="external" format="html">CSS Sizing 3 §3.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>max-height</codeph></entry>
                            <entry>Sets the largest height of the box.</entry>
                            <entry>The values of <codeph>max-width</codeph></entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-3/#propdef-max-height" scope="external" format="html">CSS Sizing 3 §3.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>max-inline-size</codeph></entry>
                            <entry>Sets the largest size along the inline axis.</entry>
                            <entry>The values of <codeph>max-width</codeph></entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-logical-1/#propdef-max-inline-size" scope="external" format="html">CSS Logical Properties 1 §4.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>max-block-size</codeph></entry>
                            <entry>Sets the largest size along the block axis.</entry>
                            <entry>The values of <codeph>max-width</codeph></entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-logical-1/#propdef-max-block-size" scope="external" format="html">CSS Logical Properties 1 §4.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>max-size</codeph></entry>
                            <entry>Sets <codeph>max-width</codeph> and <codeph>max-height</codeph>. One value applies to both.</entry>
                            <entry>One or two values of <codeph>max-width</codeph></entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-4/#propdef-max-size" scope="external" format="html">CSS Sizing 4 §3.1</xref></entry>
                        </row>
                    </tbody>
                </tgroup>
            </table>
        </section>
        <section id="scaling">
            <title>Scaling</title>
            <table id="scaling__table">
                <tgroup cols="5">
                    <thead conkeyref="ref-headers/head-properties"/>
                    <tbody>
                        <row>
                            <entry><codeph>zoom</codeph></entry>
                            <entry>Scales all the lengths of an element, such as its font size, margins and width, by a factor. <codeph>2</codeph> and <codeph>200%</codeph> double them. The property is not inherited.</entry>
                            <entry>A number or a percentage of 0 or more</entry>
                            <entry><codeph>1</codeph></entry>
                            <entry><xref href="https://drafts.csswg.org/css-viewport/#zoom-property" scope="external" format="html">CSS Viewport 1 §4</xref></entry>
                        </row>
                    </tbody>
                </tgroup>
            </table>
        </section>
        <section id="aspect-ratio-and-intrinsic-sizes">
            <title>Aspect ratio and intrinsic sizes</title>
            <table id="aspect-ratio-and-intrinsic-sizes__table">
                <tgroup cols="5">
                    <thead conkeyref="ref-headers/head-properties"/>
                    <tbody>
                        <row>
                            <entry><codeph>aspect-ratio</codeph></entry>
                            <entry>Gives the box a preferred ratio between its width and its height. The first number is the width and the second is the height. A single number is a ratio to 1.</entry>
                            <entry><codeph>auto</codeph>, a non-negative number or two non-negative numbers separated by <codeph>/</codeph>, such as <codeph>16 / 9</codeph>. <codeph>auto</codeph> can come before or after the ratio.</entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-4/#propdef-aspect-ratio" scope="external" format="html">CSS Sizing 4 §4.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>contain-intrinsic-width</codeph></entry>
                            <entry>Sets the width that a box with size containment has instead of the size of its content.</entry>
                            <entry>An optional <codeph>auto</codeph>, then <codeph>none</codeph> or a non-negative length</entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-4/#propdef-contain-intrinsic-width" scope="external" format="html">CSS Sizing 4 §5.2</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>contain-intrinsic-height</codeph></entry>
                            <entry>Sets the height that a box with size containment has instead of the size of its content.</entry>
                            <entry>The values of <codeph>contain-intrinsic-width</codeph></entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-4/#propdef-contain-intrinsic-height" scope="external" format="html">CSS Sizing 4 §5.2</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>contain-intrinsic-inline-size</codeph></entry>
                            <entry>Sets the inline size that a box with size containment has instead of the size of its content.</entry>
                            <entry>The values of <codeph>contain-intrinsic-width</codeph></entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-4/#propdef-contain-intrinsic-inline-size" scope="external" format="html">CSS Sizing 4 §5.2</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>contain-intrinsic-block-size</codeph></entry>
                            <entry>Sets the block size that a box with size containment has instead of the size of its content.</entry>
                            <entry>The values of <codeph>contain-intrinsic-width</codeph></entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-4/#propdef-contain-intrinsic-block-size" scope="external" format="html">CSS Sizing 4 §5.2</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>contain-intrinsic-size</codeph></entry>
                            <entry>Sets <codeph>contain-intrinsic-width</codeph> and <codeph>contain-intrinsic-height</codeph>. One value applies to both.</entry>
                            <entry>One or two values of <codeph>contain-intrinsic-width</codeph></entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-4/#propdef-contain-intrinsic-size" scope="external" format="html">CSS Sizing 4 §5.2</xref></entry>
                        </row>
                        <!-- TODO: frame-sizing and min-intrinsic-sizing are read and have no effect in the PDF; check them when the engine uses them -->
                        <row>
                            <entry><codeph>frame-sizing</codeph></entry>
                            <entry>Chooses the size of a replaced element that is used for its sizing.</entry>
                            <entry><codeph>auto</codeph>, <codeph>content-width</codeph>, <codeph>content-height</codeph>, <codeph>content-block-size</codeph> or <codeph>content-inline-size</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-4/#propdef-frame-sizing" scope="external" format="html">CSS Sizing 4 §5.3</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>min-intrinsic-sizing</codeph></entry>
                            <entry>Chooses when the minimum size that a box contributes to its container is compressed.</entry>
                            <entry><codeph>legacy</codeph>, <codeph>zero-if-scroll</codeph>, <codeph>zero-if-extrinsic</codeph> or both of the last two</entry>
                            <entry><codeph>legacy</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-sizing-4/#propdef-min-intrinsic-sizing" scope="external" format="html">CSS Sizing 4 §5.5</xref></entry>
                        </row>
                    </tbody>
                </tgroup>
            </table>
        </section>
    </refbody>
</reference>
