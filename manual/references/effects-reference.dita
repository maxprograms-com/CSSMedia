<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="effects-reference">
    <title>Shadows, opacity, transforms and masks</title>
    <shortdesc>This reference lists the properties that make an element transparent, move, turn or scale it, clip it or mask it, and mix it with what is behind it.</shortdesc>
    <refbody>
        <section id="effects-properties">
            <title>Opacity, clipping, masking and transform properties</title>
            <table id="effects-properties__table">
                <tgroup cols="5">
                    <thead conkeyref="ref-headers/head-properties"><row><entry/><entry/><entry/><entry/><entry/></row></thead>
                    <tbody>
                        <row>
                            <entry><codeph>opacity</codeph></entry>
                            <entry>Makes an element and its children transparent as a group.</entry>
                            <entry>A number from 0 to 1, or a percentage. A number outside that range is clamped.</entry>
                            <entry><codeph>1</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-color-4/#transparency" scope="external" format="html">CSS Color 4 §3.3</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>clip-path</codeph></entry>
                            <entry>Shows only the part of an element inside an area.</entry>
                            <entry><codeph>none</codeph>, <codeph>url(#id)</codeph> of a <codeph>clipPath</codeph>, or a basic shape (<codeph>circle()</codeph>, <codeph>ellipse()</codeph>, <codeph>inset()</codeph>, <codeph>xywh()</codeph>, <codeph>rect()</codeph>, <codeph>polygon()</codeph>, <codeph>path()</codeph> or <codeph>shape()</codeph>), with <codeph>fill-box</codeph>, <codeph>stroke-box</codeph>, <codeph>view-box</codeph>, <codeph>content-box</codeph>, <codeph>padding-box</codeph>, <codeph>border-box</codeph> or <codeph>margin-box</codeph></entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-masking-1/#the-clip-path" scope="external" format="html">CSS Masking 1 §5.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>clip-rule</codeph></entry>
                            <entry>Chooses which areas of a shape inside a <codeph>clipPath</codeph> are inside it.</entry>
                            <entry><codeph>nonzero</codeph> or <codeph>evenodd</codeph></entry>
                            <entry><codeph>nonzero</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-masking-1/#the-clip-rule" scope="external" format="html">CSS Masking 1 §6.2</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>mask</codeph></entry>
                            <entry>Makes parts of an element transparent with one or more <codeph>mask</codeph> elements. It is the shorthand of the mask layer properties.</entry>
                            <entry><codeph>none</codeph>, or a list of layers separated by commas, each with <codeph>url(#id)</codeph> of a <codeph>mask</codeph> element</entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-masking-1/#the-mask" scope="external" format="html">CSS Masking 1 §7.9</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>mask-image</codeph></entry>
                            <entry>Lists the layers of the mask of an element. The first layer is the top one.</entry>
                            <entry>A list, separated by commas, of <codeph>none</codeph>, <codeph>url(#id)</codeph> of a <codeph>mask</codeph> element, and images: the URL of an image file, a gradient, <codeph>image-set()</codeph>, <codeph>image()</codeph> or <codeph>cross-fade()</codeph></entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-masking-1/#the-mask-image" scope="external" format="html">CSS Masking 1 §7.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>mask-repeat</codeph></entry>
                            <entry>Chooses for each image layer whether the image repeats across the mask and how.</entry>
                            <entry>A list of <codeph>repeat-x</codeph>, <codeph>repeat-y</codeph>, or one or two of <codeph>repeat</codeph>, <codeph>space</codeph>, <codeph>round</codeph> and <codeph>no-repeat</codeph></entry>
                            <entry><codeph>repeat</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-masking-1/#the-mask-repeat" scope="external" format="html">CSS Masking 1 §7.3</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>mask-position</codeph></entry>
                            <entry>Places each image layer in its positioning area.</entry>
                            <entry>A list of positions, each one to four keywords, lengths and percentages</entry>
                            <entry><codeph>0% 0%</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-masking-1/#the-mask-position" scope="external" format="html">CSS Masking 1 §7.4</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>mask-clip</codeph></entry>
                            <entry>Chooses the area that each layer paints in, or <codeph>no-clip</codeph> for no limit.</entry>
                            <entry>A list of <codeph>fill-box</codeph>, <codeph>stroke-box</codeph>, <codeph>view-box</codeph>, <codeph>content-box</codeph>, <codeph>padding-box</codeph>, <codeph>border-box</codeph>, <codeph>margin-box</codeph> or <codeph>no-clip</codeph></entry>
                            <entry><codeph>border-box</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-masking-1/#the-mask-clip" scope="external" format="html">CSS Masking 1 §7.5</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>mask-origin</codeph></entry>
                            <entry>Chooses the area that <codeph>mask-position</codeph> and <codeph>mask-size</codeph> refer to, for each layer.</entry>
                            <entry>A list of <codeph>fill-box</codeph>, <codeph>stroke-box</codeph>, <codeph>view-box</codeph>, <codeph>content-box</codeph>, <codeph>padding-box</codeph>, <codeph>border-box</codeph> or <codeph>margin-box</codeph></entry>
                            <entry><codeph>border-box</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-masking-1/#the-mask-origin" scope="external" format="html">CSS Masking 1 §7.6</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>mask-size</codeph></entry>
                            <entry>Sets the size of each image layer.</entry>
                            <entry>A list of <codeph>auto</codeph>, <codeph>cover</codeph>, <codeph>contain</codeph>, or one or two lengths, percentages or <codeph>auto</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-masking-1/#the-mask-size" scope="external" format="html">CSS Masking 1 §7.7</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>mask-mode</codeph></entry>
                            <entry>Chooses for each layer whether the mask uses the luminance or the alpha of what it holds, in place of the <codeph>mask-type</codeph> of the <codeph>mask</codeph> element.</entry>
                            <entry>A list of <codeph>match-source</codeph>, <codeph>luminance</codeph> or <codeph>alpha</codeph></entry>
                            <entry><codeph>match-source</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-masking-1/#the-mask-mode" scope="external" format="html">CSS Masking 1 §7.2</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>mask-composite</codeph></entry>
                            <entry>Chooses for each layer how it combines with the layers below it.</entry>
                            <entry>A list of <codeph>add</codeph>, <codeph>subtract</codeph>, <codeph>intersect</codeph> or <codeph>exclude</codeph></entry>
                            <entry><codeph>add</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-masking-1/#the-mask-composite" scope="external" format="html">CSS Masking 1 §7.8</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>mask-type</codeph></entry>
                            <entry>Chooses whether a <codeph>mask</codeph> element uses the luminance or the opacity of what it holds.</entry>
                            <entry><codeph>luminance</codeph> or <codeph>alpha</codeph></entry>
                            <entry><codeph>luminance</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-masking-1/#the-mask-type" scope="external" format="html">CSS Masking 1 §9.2</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>transform</codeph></entry>
                            <entry>Moves, turns, scales or skews an element and its children.</entry>
                            <entry><codeph>none</codeph> or a list of transform functions, 2D or 3D</entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-transforms-1/#transform-property" scope="external" format="html">CSS Transforms 1 §4</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>transform-origin</codeph></entry>
                            <entry>Sets the point that <codeph>transform</codeph> turns and scales around. In a drawing it is the origin of the drawing, and on a box it is the center of the box.</entry>
                            <entry>One to three lengths, percentages or keywords</entry>
                            <entry><codeph>0 0</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-transforms-1/#transform-origin-property" scope="external" format="html">CSS Transforms 1 §5</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>transform-box</codeph></entry>
                            <entry>Chooses the reference box for the percentages and the keywords of <codeph>transform</codeph> and <codeph>transform-origin</codeph>.</entry>
                            <entry><codeph>view-box</codeph>, <codeph>fill-box</codeph>, <codeph>stroke-box</codeph>, <codeph>content-box</codeph> or <codeph>border-box</codeph></entry>
                            <entry><codeph>view-box</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-transforms-1/#transform-box" scope="external" format="html">CSS Transforms 1 §6</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>translate</codeph>, <codeph>rotate</codeph>, <codeph>scale</codeph></entry>
                            <entry>Move, turn or scale an element, each in a property of its own.</entry>
                            <entry><codeph>none</codeph> or the arguments of the function of the same name</entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-transforms-2/#individual-transforms" scope="external" format="html">CSS Transforms 2 §5</xref></entry>
                        </row>
                    </tbody>
                </tgroup>
            </table>
        </section>
        <section id="effects-3d">
            <title>Three-dimensional transforms</title>
            <table id="effects-3d__table">
                <tgroup cols="5">
                    <thead conkeyref="ref-headers/head-properties"><row><entry/><entry/><entry/><entry/><entry/></row></thead>
                    <tbody>
                        <row>
                            <entry><codeph>perspective</codeph></entry>
                            <entry>Sets the distance from the reader to the drawing for the children of an element.</entry>
                            <entry><codeph>none</codeph> or a length. A length below 1px counts as 1px.</entry>
                            <entry><codeph>none</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-transforms-2/#perspective-property" scope="external" format="html">CSS Transforms 2 §8</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>perspective-origin</codeph></entry>
                            <entry>Sets the point of view of the children of an element, on the plane of the drawing.</entry>
                            <entry>A position, as in <codeph>background-position</codeph></entry>
                            <entry><codeph>50% 50%</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-transforms-2/#perspective-origin-property" scope="external" format="html">CSS Transforms 2 §9</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>transform-style</codeph></entry>
                            <entry>Chooses whether the children of an element share one three-dimensional space or are flattened into the plane of the element.</entry>
                            <entry><codeph>flat</codeph> or <codeph>preserve-3d</codeph></entry>
                            <entry><codeph>flat</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-transforms-2/#transform-style-property" scope="external" format="html">CSS Transforms 2 §7</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>backface-visibility</codeph></entry>
                            <entry>Chooses whether an element is drawn when its back faces the reader.</entry>
                            <entry><codeph>visible</codeph> or <codeph>hidden</codeph></entry>
                            <entry><codeph>visible</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/css-transforms-2/#backface-visibility-property" scope="external" format="html">CSS Transforms 2 §10</xref></entry>
                        </row>
                    </tbody>
                </tgroup>
            </table>
        </section>
        <section id="effects-blending">
            <title>Blending</title>
            <table id="effects-blending__table">
                <tgroup cols="5">
                    <thead conkeyref="ref-headers/head-properties"><row><entry/><entry/><entry/><entry/><entry/></row></thead>
                    <tbody>
                        <row>
                            <entry><codeph>mix-blend-mode</codeph></entry>
                            <entry>Sets how an element blends with what is behind it.</entry>
                            <entry>The values of <codeph>background-blend-mode</codeph></entry>
                            <entry><codeph>normal</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/compositing-1/#propdef-mix-blend-mode" scope="external" format="html">Compositing 1 §3.4.1</xref></entry>
                        </row>
                        <row>
                            <entry><codeph>isolation</codeph></entry>
                            <entry>Chooses whether an element makes a group of its own for blending.</entry>
                            <entry><codeph>auto</codeph> or <codeph>isolate</codeph></entry>
                            <entry><codeph>auto</codeph></entry>
                            <entry><xref href="https://www.w3.org/TR/compositing-1/#propdef-isolation" scope="external" format="html">Compositing 1 §3.4.2</xref></entry>
                        </row>
                    </tbody>
                </tgroup>
            </table>
        </section>
    </refbody>
</reference>
